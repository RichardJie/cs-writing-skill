        "fontSize": 26,
        "lineSpacing": 1.1,
        "bold": true
      },
      "subtitle": {
        "fontSize": 15,
        "lineSpacing": 1.2,
        "italic": true,
        "bold": false
      },
      "cardTitle": {
        "fontSize": 17,
        "lineSpacing": 1.2,
        "bold": true
      },
      "cardBody": {
        "fontSize": 13,
        "lineSpacing": 1.20,
        "bold": false
      },
      "cardBodyDense": {
        "fontSize": 12,
        "lineSpacing": 1.20,
        "bold": false
      },
      "noteAnnotation": {
        "fontSize": 12,
        "lineSpacing": 1.20,
        "bold": false,
        "italic": false
      },
      "tracker": {
        "fontSize": 10,
        "lineSpacing": 1.0,
        "bold": true,
        "caps": true
      },
      "footer": {
        "fontSize": 10,
        "lineSpacing": 1.0,
        "bold": false
