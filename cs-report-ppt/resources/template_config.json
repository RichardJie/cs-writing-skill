{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "meta": {
    "name": "cs-report-ppt-template-config",
    "version": "2.0.0",
    "defaultTheme": "academic_mono",
    "description": "Standardized 16:9 layout coordinates, 7 core gridModels, 12 aspect-ratio layoutRecipes, bilingual typography scales, and 6 curated scholarly THEMES (+ 5 conference presets) for academic presentations."
  },
  "canvas": {
    "width": 13.333,
    "height": 7.500,
    "unit": "inches",
    "aspectRatio": "16:9",
    "dpi": 96,
    "pixelWidth": 1280,
    "pixelHeight": 720,
    "emuWidth": 12192000,
    "emuHeight": 6858000
  },
  "layout": {
    "margins": {
      "left": 0.600,
      "right": 0.600,
      "top": 0.350,
      "bottom": 0.150
    },
    "zones": {
      "breadcrumb": {
        "x": 0.600,
        "y": 0.000,
        "width": 12.133,
        "height": 0.320,
        "fontSize": 9.5,
        "description": "Optional persistent chapter progress bar for Thesis Defense and Grant decks"
      },
      "header": {
        "x": 0.600,
        "y": 0.350,
        "width": 12.133,
        "height": 1.200,
        "tracker": {
          "x": 0.600,
          "y": 0.350,
          "width": 8.000,
          "height": 0.250,
          "fontSize": 10,
          "bold": true
        },
        "title": {
          "x": 0.600,
          "y": 0.600,
          "width": 12.133,
          "height": 0.480,
          "fontSize": 26,
          "bold": true
        },
        "subtitle": {
          "x": 0.600,
          "y": 1.080,
          "width": 12.133,
          "height": 0.350,
          "fontSize": 15,
          "italic": true,
          "bold": false
        },
        "divider": {
          "x": 0.600,
          "y": 1.500,
          "width": 12.133,
          "height": 0.010
        }
      },
      "content": {
        "x": 0.600,
        "y": 1.650,
        "width": 12.133,
        "height": 5.200,
        "defaultGap": 0.300
      },
      "footer": {
        "x": 0.600,
        "y": 7.000,
        "width": 12.133,
        "height": 0.350,
        "fontSize": 10
      }
    },
    "gridModels": {
      "hero_1col": {
        "description": "Single wide hero card for high-impact diagrams or master benchmark tables",
        "columns": 1,
        "cards": [
          {
            "id": "card_0",
            "x": 0.600,
            "y": 1.650,
            "w": 12.133,
            "h": 5.200
          }
        ]
      },
      "split_equal_2col": {
        "description": "Two balanced 50/50 cards for problem vs bottleneck, author claims vs critique",
        "columns": 2,
        "gap": 0.300,
        "cards": [
          {
            "id": "card_0",
            "x": 0.600,
            "y": 1.650,
            "w": 5.916,
            "h": 5.200
          },
          {
            "id": "card_1",
            "x": 6.816,
            "y": 1.650,
            "w": 5.916,
            "h": 5.200
          }
        ]
      },
      "split_65_35": {
        "description": "Asymmetric 65/35 split: 65% primary technical card and 35% marginal research connection side-note",
        "columns": 2,
        "gap": 0.300,
        "cards": [
          {
            "id": "main_card",
            "x": 0.600,
            "y": 1.650,
            "w": 7.700,
            "h": 5.200
          },
          {
            "id": "side_note_card",
            "x": 8.600,
            "y": 1.650,
            "w": 4.133,
            "h": 5.200
          }
        ]
      },
      "grid_3col": {
        "description": "Three equal columns for 3-stage workflows, baseline flaw analysis, or 3 takeaway badges",
        "columns": 3,
        "gap": 0.250,
        "cards": [
          {
            "id": "card_0",
            "x": 0.600,
            "y": 1.650,
            "w": 3.877,
            "h": 5.200
          },
          {
            "id": "card_1",
            "x": 4.727,
            "y": 1.650,
            "w": 3.877,
            "h": 5.200
          },
          {
            "id": "card_2",
            "x": 8.854,
            "y": 1.650,
            "w": 3.877,
            "h": 5.200
          }
        ]
      },
      "grid_4col": {
        "description": "Four equal columns for 4-phase pipelines, 4 benchmark datasets, or discussion prompts",
        "columns": 4,
        "gap": 0.200,
        "cards": [
          {
            "id": "card_0",
            "x": 0.600,
            "y": 1.650,
            "w": 2.883,
            "h": 5.200
          },
          {
            "id": "card_1",
            "x": 3.683,
            "y": 1.650,
            "w": 2.883,
            "h": 5.200
          },
          {
            "id": "card_2",
            "x": 6.766,
            "y": 1.650,
            "w": 2.883,
            "h": 5.200
          },
          {
            "id": "card_3",
            "x": 9.849,
            "y": 1.650,
            "w": 2.883,
            "h": 5.200
          }
        ]
      },
      "quadrant_2x2": {
        "description": "2x2 four quadrant grid for SWOT analysis, 4 ablation dimensions, or 4-modality matrix",
        "rows": 2,
        "columns": 2,
        "gapX": 0.300,
        "gapY": 0.250,
        "cards": [
          {
            "id": "quad_top_left",
            "x": 0.600,
            "y": 1.650,
            "w": 5.916,
            "h": 2.475
          },
          {
            "id": "quad_top_right",
            "x": 6.816,
            "y": 1.650,
            "w": 5.916,
            "h": 2.475
          },
          {
            "id": "quad_bottom_left",
            "x": 0.600,
            "y": 4.375,
            "w": 5.916,
            "h": 2.475
          },
          {
            "id": "quad_bottom_right",
            "x": 6.816,
            "y": 4.375,
            "w": 5.916,
            "h": 2.475
          }
        ]
      },
      "asymmetric_2row": {
        "description": "Top hero section with bottom 2 supporting cards",
        "rows": 2,
        "gapY": 0.200,
        "gapX": 0.300,
        "cards": [
          {
            "id": "hero_top",
            "x": 0.600,
            "y": 1.650,
            "w": 12.133,
            "h": 2.300
          },
          {
            "id": "bottom_left",
            "x": 0.600,
            "y": 4.150,
            "w": 5.916,
            "h": 2.700
          },
          {
            "id": "bottom_right",
            "x": 6.816,
            "y": 4.150,
            "w": 5.916,
            "h": 2.700
          }
        ]
      }
    },
    "layoutRecipes": {
      "title_hero_split": {
        "aspectRatioRule": "Slide 1 opening metadata + teaser figure split",
        "slots": [
          { "id": "venue_badge", "x": 0.600, "y": 0.850, "w": 4.200, "h": 0.320 },
          { "id": "paper_title", "x": 0.600, "y": 1.300, "w": 5.850, "h": 1.850 },
          { "id": "authors_meta", "x": 0.600, "y": 3.250, "w": 5.850, "h": 1.200 },
          { "id": "presenter_box", "x": 0.600, "y": 4.550, "w": 5.850, "h": 0.800 },
          { "id": "teaser_canvas", "x": 6.750, "y": 0.850, "w": 5.983, "h": 4.500 },
          { "id": "contrib_strip", "x": 0.600, "y": 5.650, "w": 12.133, "h": 1.200 }
        ]
      },
      "panorama_arch_top_bottom": {
        "aspectRatioRule": "R = W/H > 2.0 (wide pipeline or evolutionary timeline)",
        "slots": [
          { "id": "hero_figure", "x": 0.600, "y": 1.650, "w": 12.133, "h": 3.150 },
          { "id": "stage_card_1", "x": 0.600, "y": 5.000, "w": 3.877, "h": 1.850 },
          { "id": "stage_card_2", "x": 4.728, "y": 5.000, "w": 3.877, "h": 1.850 },
          { "id": "stage_card_3", "x": 8.856, "y": 5.000, "w": 3.877, "h": 1.850 }
        ]
      },
      "asymmetric_62_38_figure_left": {
        "aspectRatioRule": "1.15 <= R <= 2.0 (landscape plot/diagram + dissection + sidenote)",
        "slots": [
          { "id": "figure_left", "x": 0.600, "y": 1.650, "w": 7.450, "h": 5.200 },
          { "id": "analysis_top", "x": 8.300, "y": 1.650, "w": 4.433, "h": 3.450 },
          { "id": "synergy_bot", "x": 8.300, "y": 5.300, "w": 4.433, "h": 1.550 }
        ]
      },
      "tall_diagram_38_62_split": {
        "aspectRatioRule": "R < 0.85 (portrait flowchart/CONSORT + 3 stacked stage cards)",
        "slots": [
          { "id": "tall_figure", "x": 0.600, "y": 1.650, "w": 4.550, "h": 5.200 },
          { "id": "row_stage_1", "x": 5.400, "y": 1.650, "w": 7.333, "h": 1.600 },
          { "id": "row_stage_2", "x": 5.400, "y": 3.450, "w": 7.333, "h": 1.600 },
          { "id": "row_stage_3", "x": 5.400, "y": 5.250, "w": 7.333, "h": 1.600 }
        ]
      },
      "split_equal_50_50_ab": {
        "aspectRatioRule": "0.85 <= R < 1.15 or A/B comparison (Prior Art vs Ours)",
        "slots": [
          { "id": "left_panel", "x": 0.600, "y": 1.650, "w": 5.916, "h": 5.200 },
          { "id": "right_panel", "x": 6.817, "y": 1.650, "w": 5.916, "h": 5.200 }
        ]
      },
      "split_65_35_sidenote": {
        "aspectRatioRule": "65% main canvas + full-height 35% Research Synergy sidenote",
        "slots": [
          { "id": "main_card", "x": 0.600, "y": 1.650, "w": 7.700, "h": 5.200 },
          { "id": "side_note", "x": 8.600, "y": 1.650, "w": 4.133, "h": 5.200 }
        ]
      },
      "formula_omml_workbench": {
        "aspectRatioRule": "Master OMML equation hero + symbol glossary + geometric intuition plot",
        "slots": [
          { "id": "omml_hero", "x": 0.600, "y": 1.650, "w": 12.133, "h": 1.750 },
          { "id": "symbol_table", "x": 0.600, "y": 3.600, "w": 6.200, "h": 3.250 },
          { "id": "intuition_fig", "x": 7.050, "y": 3.600, "w": 5.683, "h": 3.250 }
        ]
      },
      "benchmark_table_kpi_strip": {
        "aspectRatioRule": "Focal booktabs SOTA/regression table + 3 bottom KPI delta badges",
        "slots": [
          { "id": "master_table", "x": 0.600, "y": 1.650, "w": 12.133, "h": 3.650 },
          { "id": "kpi_badge_1", "x": 0.600, "y": 5.500, "w": 3.877, "h": 1.350 },
          { "id": "kpi_badge_2", "x": 4.728, "y": 5.500, "w": 3.877, "h": 1.350 },
          { "id": "kpi_badge_3", "x": 8.856, "y": 5.500, "w": 3.877, "h": 1.350 }
        ]
      },
      "quadrant_2x2_ablation": {
        "aspectRatioRule": "4-quadrant ablation, sensitivity, or 2x2 conceptual matrix",
        "slots": [
          { "id": "quad_tl", "x": 0.600, "y": 1.650, "w": 5.916, "h": 2.475 },
          { "id": "quad_tr", "x": 6.817, "y": 1.650, "w": 5.916, "h": 2.475 },
          { "id": "quad_bl", "x": 0.600, "y": 4.375, "w": 5.916, "h": 2.475 },
          { "id": "quad_br", "x": 6.817, "y": 4.375, "w": 5.916, "h": 2.475 }
        ]
      },
      "grid_3col_taxonomy": {
        "aspectRatioRule": "3-column taxonomy, experimental protocol, or Gioia coding flow",
        "slots": [
          { "id": "col_1", "x": 0.600, "y": 1.650, "w": 3.877, "h": 5.200 },
          { "id": "col_2", "x": 4.728, "y": 1.650, "w": 3.877, "h": 5.200 },
          { "id": "col_3", "x": 8.856, "y": 1.650, "w": 3.877, "h": 5.200 }
        ]
      },
      "qualitative_gallery_matrix": {
        "aspectRatioRule": "4-column multi-row visual gallery + right qualitative verdict rail",
        "slots": [
          { "id": "col_headers", "x": 0.600, "y": 1.650, "w": 9.050, "h": 0.360 },
          { "id": "visual_row_1", "x": 0.600, "y": 2.150, "w": 9.050, "h": 1.460 },
          { "id": "visual_row_2", "x": 0.600, "y": 3.770, "w": 9.050, "h": 1.460 },
          { "id": "visual_row_3", "x": 0.600, "y": 5.390, "w": 9.050, "h": 1.460 },
          { "id": "verdict_rail", "x": 9.900, "y": 1.650, "w": 2.833, "h": 5.200 }
        ]
      },
      "defense_roadmap_tracker_canvas": {
        "aspectRatioRule": "Thesis Defense / NSFC Grant slide with top progress bar + bottom verdict strip",
        "slots": [
          { "id": "nav_bar", "x": 0.600, "y": 0.320, "w": 12.133, "h": 0.280 },
          { "id": "defense_title", "x": 0.600, "y": 0.680, "w": 12.133, "h": 0.480 },
          { "id": "mech_canvas", "x": 0.600, "y": 1.650, "w": 7.200, "h": 3.850 },
          { "id": "proof_canvas", "x": 8.050, "y": 1.650, "w": 4.683, "h": 3.850 },
          { "id": "verdict_strip", "x": 0.600, "y": 5.700, "w": 12.133, "h": 1.150 }
        ]
      }
    }
  },
  "typography": {
    "fonts": {
      "heading": "Arial",
      "body": "Arial",
      "mono": "Courier New",
      "math": "Cambria Math"
